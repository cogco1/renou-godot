[gd_scene format=3]

[ext_resource type="Theme" path="res://ui/theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://ui/interaction_prompt.gd" id="2_prompt"]
[ext_resource type="Script" path="res://ui/widgets/ui_glyph.gd" id="3_glyph"]

[node name="InteractionPrompt" type="PanelContainer"]
mouse_filter = 2
theme = ExtResource("1_theme")
theme_type_variation = &"PromptPlate"
script = ExtResource("2_prompt")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="KeyCap" type="PanelContainer" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_type_variation = &"KeyCap"

[node name="KeyLabel" type="Label" parent="Row/KeyCap"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"KeyCapLabel"
text = "E"
horizontal_alignment = 1

[node name="BlockedIcon" type="Control" parent="Row"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(20, 20)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
script = ExtResource("3_glyph")
kind = "blocked"
color = Color(0.9373, 0.902, 0.8118, 0.64)

[node name="Verb" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PromptLabel"
text = "检查"

[node name="Target" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PromptTarget"
text = "配电箱"

[node name="Reason" type="Label" parent="Row"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "· 过去才能用"
