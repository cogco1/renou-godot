  "local_state_rules": {
    "status": "implementation_spec_not_runtime",
    "source_of_truth": "initial_state.flags；运行时由共享状态持有，视觉/碰撞从状态派生",
    "idempotence": "赋值而非切换或累加；输入去抖；首次满足完成条件只发一次 level.completed",
    "reset_semantics": {
      "checkpoint": "恢复最近合法检查点的era与本关flags快照；没有快照则回本关初态安全出生点",
      "restart_level": "清除本关状态并恢复initial_state，不清除其他关卡",
      "reload": "从保存的权威状态重建全部外观、动件终态和碰撞"
    },
    "transitions": [
      {
        "event": {
          "event_type": "interact.request",
          "level_id": "mvp_cabinet",
          "device_id": "plaque",
          "action": "read"
        },
        "requires": [
          "era==past",
          "真实可读/交互范围"
        ],
        "assign": {
          "clue_seen": true
        },
        "otherwise": "wrong_era或out_of_range"
      },
      {
        "event": {
          "event_type": "interact.request",
          "level_id": "mvp_cabinet",
          "device_id": "cabinet",
          "action": "submit_code",
          "value": null
        },
        "requires": [
          "era==present",
          "有效密码UI",
          "输入等于final_code，或显式test_mode时等于test_code"
        ],
        "assign": {
          "cabinet_unlocked": true
        },
        "otherwise": "wrong_code或wrong_era或config_missing；flags不变、可立即重试",
        "notes": "clue_seen不是前置；final_code=null且test_mode=false应报告配置缺失，不把空码当正确"
      },
      {
        "event": {
          "event_type": "interact.request",
          "level_id": "mvp_cabinet",
          "device_id": "start_button",
          "action": "press"
        },
        "requires": [
          "era==present",
          "cabinet_unlocked==true",
          "有效交互距离和视线"
        ],
        "assign": {
          "power_on": true
        },
        "otherwise": "prerequisites_unmet或wrong_era"
      },
      {
        "event": {
          "event_type": "interact.request",
          "level_id": "mvp_cabinet",
          "device_id": "exit_trigger",
          "action": "enter"
        },
        "requires": [
          "era==present",
          "power_on==true",
          "真实进入exit"
        ],
        "assign": {
          "exit_reached": true
        },
        "otherwise": "wrong_era优先；时代正确但机关前置未满足则prerequisites_unmet；不加空气墙"
      }
    ],
    "derived_state": [
      {
        "when": "era==present && power_on==false",
        "door": "closed",
        "work_lights": "off",
        "panel": "standby"
      },
      {
        "when": "era==present && cabinet_unlocked==true",
        "start_button": "enabled"
      },
      {
        "when": "era==present && power_on==true",
        "door": "open",
        "work_lights": "on",
        "activation_sequence": "箱旁灯→出口灯→开门，时序长度待调"
      },
      {
        "when": "era==past",
        "plaque": "legible",
        "start_button": "absent_and_not_interactable",
        "door_and_lights": "source_unspecified_do_not_copy_present_power_state"
      }
    ],
    "ui": "输入UI拥有其提交/取消；不得把UI自身一起禁用。关闭、切时代、reset、离场都要释放或恢复正确输入模式。"
